    "settings_crash_report_footer": {
      "comment": "Footer explaining the crash report feature",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die App abgestürzt ist, wird ein Bericht auf diesem Gerät gespeichert und kann mit dem Entwickler geteilt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app crashed, a report is saved on this device and can be shared with the developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app falla, se guarda un informe en este dispositivo que puedes compartir con el desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'app plante, un rapport est enregistré sur cet appareil et peut être partagé avec le développeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'app va in crash, un rapporto viene salvato su questo dispositivo e può essere condiviso con lo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがクラッシュすると、レポートがこのデバイスに保存され、開発者と共有できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de app crasht, wordt een rapport op dit apparaat bewaard dat je met de ontwikkelaar kunt delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli aplikacja ulegnie awarii, raport zostanie zapisany na tym urządzeniu i można go udostępnić deweloperowi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a app falhar, é guardado um relatório neste dispositivo que pode partilhar com o programador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果应用崩溃，报告会保存在此设备上，并可分享给开发者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若 App 當機，報告會儲存在此裝置上，並可分享給開發者。"
          }
        }
      }
    },
