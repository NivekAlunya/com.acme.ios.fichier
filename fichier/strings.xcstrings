    "storage_error_locate_folder": {
      "comment": "Error message when security-scoped folder bookmark cannot be resolved",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner „%@“ konnte nicht gefunden werden. Wenn er sich auf einem externen Laufwerk befindet, stelle sicher, dass es angeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to locate folder '%@'. If it is on an external drive, ensure the drive is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede localizar la carpeta «%@». Si está en un disco externo, asegúrate de que esté conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de localiser le dossier « %@ ». S’il est sur un disque externe, vérifiez qu’il est connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare la cartella '%@'. Se si trova su un disco esterno, verifica che sia collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ“%@”が見つかりません。外付けドライブにある場合は、接続されていることを確認してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan map '%@' niet vinden. Als deze op een externe schijf staat, controleer dan of de schijf is aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zlokalizować folderu „%@”. Jeśli znajduje się na dysku zewnętrznym, upewnij się, że dysk jest podłączony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível localizar a pasta «%@». Se estiver num disco externo, certifique-se de que está ligado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法找到文件夹“%@”。若位于外置驱动器上，请确保该驱动器已连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到檔案夾「%@」。若該檔案夾位於外接硬碟上，請確認硬碟已連接。"
          }
        }
      }
    },
    "storage_error_permission_expired": {
      "comment": "Error message when folder access permission has expired",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriffsberechtigung für Ordner „%@“ abgelaufen. Bitte wähle den Ordner in den Einstellungen oder der Seitenleiste erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access permission expired for folder '%@'. Please re-select the folder in Settings or Sidebar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de acceso para la carpeta «%@» ha caducado. Vuelve a seleccionar la carpeta en Ajustes o en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’accès au dossier « %@ » a expiré. Veuillez sélectionner à nouveau le dossier dans les Réglages ou la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione di accesso per la cartella '%@' è scaduta. Seleziona nuovamente la cartella in Impostazioni o nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ“%@”のアクセス権の有効期限が切れました。設定またはサイドバーでフォルダを再選択してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegangstoestemming voor map '%@' is verlopen. Selecteer de map opnieuw in Instellingen of de navigatiekolom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienia dostępu do folderu „%@” wygasły. Wybierz folder ponownie w Ustawieniach lub na pasku bocznym."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autorização de acesso à pasta «%@» expirou. Selecione novamente a pasta nas Definições ou na barra lateral."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹“%@”的访问权限已过期。请在设置或边栏中重新选择该文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾「%@」的存取權限已過期。請在「設定」或側邊欄中重新選取該檔案夾。"
          }
        }
      }
    },
