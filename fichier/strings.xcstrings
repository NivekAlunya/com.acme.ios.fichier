    "settings_system_footer": {
      "comment": "Explanation of permissions in system settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie Berechtigungen für das lokale Netzwerk, Fotos und Apps in den iOS-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage Local Network permissions, Photos access, and app permissions in the iOS Settings app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los permisos de red local, acceso a Fotos y permisos en los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérer les autorisations réseau local, l’accès aux Photos et les réglages dans l’application Réglages iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci i permessi per la rete locale, l accesso alle Foto e i permessi dell app nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークの許可、写真へのアクセス、アプリの権限をiOS設定で管理します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer lokale netwerkrechten, toegang tot Foto s en app-machtigingen in de iOS-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj uprawnieniami sieci lokalnej, dostępem do Zdjęć i uprawnieniami aplikacji w Ustawieniach iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerir permissões de rede local, acesso às Fotografias e permissões da app nas Definições do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 设置中管理本地网络权限、照片访问权限和应用权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 設定中管理區域網路權限、照片存取權限和應用程式權限。"
          }
        }
      }
    },
