    "photos_permission_denied_message": {
      "comment": "Message explaining how to allow Photos access in Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please grant access to your Photos library in Settings to browse albums and media."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez autoriser l’accès à votre photothèque dans Réglages pour parcourir vos albums et médias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gewähre in den Einstellungen Zugriff auf deine Fotomediathek, um Alben und Medien zu durchsuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tu fototeca en Ajustes para ver álbumes y archivos multimedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso alla tua libreria foto in Impostazioni per sfogliare album e file multimediali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムやメディアを閲覧するには、設定で写真ライブラリへのアクセスを許可してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef in Instellingen toegang tot je fotobibliotheek om albums en media te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do biblioteki zdjęć w Ustawieniach, aby przeglądać albumy i multimedia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à sua Fototeca nas Definições para explorar álbuns e multimédia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问您的照片图库，以浏览相册和媒体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許存取您的照片圖庫，以瀏覽相簿與媒體。"
          }
        }
      }
    },
