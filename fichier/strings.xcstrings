    "tv_photos_access_denied_description": {
      "comment": "Instructions on how to enable Photos access in Apple TV Settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Fotos ist deaktiviert. Bitte aktiviere ihn in den Apple TV-Einstellungen > Apps > Fichier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to Photos is disabled. Please enable it in Apple TV Settings > Apps > Fichier."
          }
        },
        "es": {
          "stringUnit": {
