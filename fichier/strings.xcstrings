    "settings_clear_cache_dialog_message": {
      "comment": "Message in clear cache confirmation dialog",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie wirklich alle lokal zwischengespeicherten Miniaturansichten und Videovorschauen von diesem Gerät entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove all locally cached thumbnails and video previews from this device?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar todas las miniaturas y vistas previas de vídeo almacenadas en este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer toutes les miniatures et aperçus vidéo en cache de cet appareil ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler rimuovere tutte le miniature e le anteprime video memorizzate su questo dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからローカルにキャッシュされたすべてのサムネイルとビデオプレビューを削除してもよろしいですか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u alle lokaal gecachete miniaturen en videovoorvertoningen van dit apparaat wilt verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć z tego urządzenia wszystkie lokalne miniatury i podglądy wideo?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende remover todas as miniaturas e pré-visualizações de vídeo deste dispositivo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要从此设备中移除所有本地缓存的缩略图和视频预览吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要從此裝置中移除所有本機快取的縮圖和影片預覽嗎？"
          }
        }
      }
    },
