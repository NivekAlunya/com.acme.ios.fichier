    "settings_storage_footer": {
      "comment": "Explanation of clearing media cache",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Leeren des Caches wird Speicherplatz freigegeben, indem lokal zwischengespeicherte Miniaturansichten und Vorschauen entfernt werden. Remotedateien auf dem SMB-Server werden nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing the cache frees up disk space by removing locally cached thumbnails and previews. Remote files on the SMB server are never modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar la caché libera espacio al eliminar miniaturas y vistas previas locales. Los archivos remotos en el servidor SMB nunca se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le cache libère de l’espace disque en supprimant les miniatures et aperçus locaux. Les fichiers distants sur le serveur SMB ne sont jamais modifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo svuotamento della cache libera spazio rimuovendo miniature e anteprime salvate localmente. I file remoti sul server SMB non vengono mai modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを消去すると、ローカルに保存されたサムネイルやプレビューが削除され、空き容量が増えます。SMBサーバー上のリモートファイルは変更されません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wissen van de cache maakt schijfruimte vrij door lokaal gecachete miniaturen en voorvertoningen te verwijderen. Externe bestanden op de SMB-server worden nooit gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie pamięci podręcznej zwalnia miejsce na dysku, usuwając lokalne miniatury i podglądy. Pliki zdalne na serwerze SMB nie są modyfikowane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar a cache liberta espaço ao remover miniaturas e pré-visualizações locais. Os ficheiros remotos no servidor SMB nunca são modificados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除缓存可通过删除本地缓存的缩略图和预览来释放存储空间。SMB 服务器上的远程文件不会受到任何影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快取可透過刪除本機快取的縮圖和預覽來釋放儲存空間。SMB 伺服器上的遠端檔案不會受到任何影響。"
          }
        }
      }
    },
